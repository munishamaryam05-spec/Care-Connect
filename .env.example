# CareConnect Environment Configuration Example
# Copy this file to .env for local development with Supabase.
# Note: For Demo Mode evaluation, CareConnect runs out-of-the-box without requiring .env!

# Supabase Project URL and Public Anon Key (Client-side)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Provider Secret (Server-side ONLY - Never expose in frontend code)
# Set this secret securely in Supabase Edge Functions using:
# supabase secrets set OPENAI_API_KEY=your_openai_api_key_here
